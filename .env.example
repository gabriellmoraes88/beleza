# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# URL pública da aplicação (sem barra no final). Ex.: https://beleza.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta (service_role). NUNCA use prefixo NEXT_PUBLIC_ nem exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# Asaas > Integrações > Chave de API. Use a do sandbox em desenvolvimento/preview.
ASAAS_API_KEY=
# https://api-sandbox.asaas.com/v3 (sandbox) ou https://api.asaas.com/v3 (produção)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token que você define ao cadastrar o webhook no Asaas (32 a 255 caracteres, sem espaços).
ASAAS_WEBHOOK_TOKEN=

# Segredo usado pela Vercel Cron para chamar a rotina de conciliação.
CRON_SECRET=

# Dias de tolerância após o vencimento antes de limitar o painel.
BILLING_GRACE_DAYS=5
